# Токен бота от @BotFather (необязательно — можно подключить позже в Настройках)
BOT_TOKEN=

# Ваш Telegram ID (если пусто — привяжется автоматически при первом сообщении боту)
ALLOWED_USER_ID=

# Порт локального веб-экрана
WEB_PORT=3847

# Опционально: ключ Google Gemini для распознавания фото расписания и голосовых
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
